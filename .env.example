NODE_ENV=development
PORT=3001
WEB_ORIGINS=http://localhost:3000

# Set exactly one database mode for the API process.
# Local SQLite (quick in-memory mode):
SQLITE_DATABASE=:memory:
# For a persistent SQLite file, use an absolute path, e.g.
# SQLITE_DATABASE=/absolute/path/to/apps/api/.local/voice-agent.sqlite

# For local Docker Compose PostgreSQL, clear SQLITE_DATABASE and set:
# DATABASE_URL=postgresql://postgres:local_dev_only_change_me@127.0.0.1:5432/voice_agent

# PostgreSQL integration tests use a separate disposable database only:
# TEST_DATABASE_URL=postgresql://postgres:local_dev_only_change_me@127.0.0.1:5432/voice_agent_test
